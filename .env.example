# Copy this file to .env and fill in values.

# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

# PostgreSQL
POSTGRES_DB=mediconnect
POSTGRES_USER=mediconnect
POSTGRES_PASSWORD=mediconnect
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Redis
REDIS_URL=redis://redis:6379/0

# Hospital scraper. Only the Docker mock site may be scraped on the private network.
SCRAPER_ALLOWED_PRIVATE_HOSTS=mockhospital
SCRAPER_JOBS_PER_USER_PER_HOUR=10

# Elasticsearch
ELASTICSEARCH_URL=http://elasticsearch:9200
ES_INDEX_PREFIX=mediconnect

# Email: Mailpit locally (see inbox at http://localhost:8025).
# For real emails, set e.g. Gmail SMTP: smtp.gmail.com / 587 / TLS=1 + app password.
EMAIL_HOST=mailpit
EMAIL_PORT=1025
EMAIL_USE_TLS=0
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=MediConnect <no-reply@mediconnect.dev>
FRONTEND_URL=http://localhost:3000

# CORS: where the Next.js app runs
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Frontend -> backend URL (as seen from the browser)
NEXT_PUBLIC_API_URL=http://localhost:8000

# OpenAI (chatbot). Create a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
CHAT_RATE_LIMIT=20
